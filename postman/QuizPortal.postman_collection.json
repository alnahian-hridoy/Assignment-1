          ] } } ],
          "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{admin_token}}" } ], "url": { "raw": "{{baseUrl}}/api/quizzes/{{quizId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "quizzes", "{{quizId}}" ] } }
        },
