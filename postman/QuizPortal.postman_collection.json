    { "key": "baseUrl", "value": "http://54.252.251.72:5001" },
    { "key": "userEmail", "value": "t.baker@example.com" },
    { "key": "adminEmail", "value": "admin@gmail.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "jwt_token", "value": "" },
