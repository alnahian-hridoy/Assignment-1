          "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{admin_token}}" } ], "url": { "raw": "{{baseUrl}}/api/questions/{{questionId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "questions", "{{questionId}}" ] } }
        },
        {
