          "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{jwt_token}}" } ], "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "tasks", "{{taskId}}" ] } }
        },
        {
