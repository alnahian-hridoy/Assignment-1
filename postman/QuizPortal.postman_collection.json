          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Content-Type header present', () => pm.response.to.have.header('Content-Type'));",
            "const res = pm.response.json();",
            "if (res.token) pm.collectionVariables.set('jwt_token', res.token);"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Michael Smith\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"pass1234\",\n  \"phone\": \"0404826234\"\n}" },
